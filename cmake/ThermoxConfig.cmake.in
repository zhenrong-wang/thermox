@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL COMPONENTS Crypto)

if(@THERMOX_ENABLE_UMFPACK@ AND
   NOT TARGET thermox::umfpack_runtime)
    find_library(
        THERMOX_SDK_UMFPACK_LIBRARY
        NAMES umfpack
        REQUIRED
    )
    add_library(thermox::umfpack_runtime UNKNOWN IMPORTED)
    set_target_properties(
        thermox::umfpack_runtime
        PROPERTIES
            IMPORTED_LOCATION
                "${THERMOX_SDK_UMFPACK_LIBRARY}"
    )
endif()

if(@THERMOX_ENABLE_CANTERA@)
    find_dependency(PkgConfig)
    pkg_check_modules(
        CANTERA
        REQUIRED
        IMPORTED_TARGET
        cantera>=3.2
    )
endif()

if(NOT TARGET thermox::coolprop_runtime)
    add_library(thermox::coolprop_runtime STATIC IMPORTED)
    set_target_properties(
        thermox::coolprop_runtime
        PROPERTIES
            IMPORTED_LOCATION
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@thermox_coolprop@CMAKE_STATIC_LIBRARY_SUFFIX@"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ThermoxTargets.cmake")
check_required_components(Thermox)
