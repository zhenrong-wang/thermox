        {"name": "shaft", "endpoint": "turbine.shaft"}
      ],
      "parameters": [
        {"name": "cooling_pressure_ratio", "target": "cooling_valve.pressure_ratio"},
        {"name": "stage_pressure_ratio", "target": "turbine.pressure_ratio"},
        {"name": "stage_eta_is", "target": "turbine.eta_is"}
      ],
      "components": [
        {
          "id": "cooling_valve",
          "kind": "transport.material.frozen_pressure_ratio",
          "version": "1.0.0",
          "parameters": {"pressure_ratio": 0.8},
          "materials": {"inlet": "gas", "outlet": "gas"}
        },
        {
          "id": "mixer",
          "kind": "junction.material.mixer.two_inlet",
          "version": "1.0.0",
          "materials": {
            "inlet_a": "gas",
            "inlet_b": "gas",
            "outlet": "gas"
          }
        },
        {
          "id": "turbine",
          "kind": "turbine.material.isentropic_efficiency",
          "version": "2.0.0",
          "parameters": {"pressure_ratio": 8.0, "eta_is": 0.9},
          "materials": {"inlet": "gas", "outlet": "gas"}
        }
      ],
      "connections": [
        {
          "id": "cooling_to_mixer",
          "from": "cooling_valve.outlet",
          "to": "mixer.inlet_b",
          "kind": "material_link"
        },
        {
          "id": "mixed_gas_to_turbine",
          "from": "mixer.outlet",
          "to": "turbine.inlet",
          "kind": "material_link"
        }
      ]
    }],
    "connections": [
      {
        "id": "hot_gas_to_stage",
        "from": "hot_gas.outlet",
        "to": "cooled_stage.inlet",
        "kind": "material_link"
      },
      {
        "id": "cooling_air_to_stage",
        "from": "cooling_air.outlet",
        "to": "cooled_stage.cooling_inlet",
        "kind": "material_link"
      },
      {
        "id": "stage_to_exhaust",
        "from": "cooled_stage.outlet",
        "to": "exhaust.inlet",
        "kind": "material_link"
      },
      {
        "id": "stage_to_load",
        "from": "cooled_stage.shaft",
        "to": "shaft_load.inlet",
        "kind": "shaft_link"
      }
    ]
  },
  "cases": [{
