# Local-development defaults. Copy to .env only when overrides are needed.
THERMOX_POSTGRES_PASSWORD=thermox-local
THERMOX_POSTGRES_PORT=55432

THERMOX_MINIO_USER=thermox-minio
THERMOX_MINIO_PASSWORD=thermox-minio-local
THERMOX_MINIO_PORT=59000
THERMOX_MINIO_CONSOLE_PORT=59001

THERMOX_API_PORT=8080
THERMOX_WEB_PORT=5173
THERMOX_LOCAL_USER_ID=local-user
THERMOX_LOCAL_TEAM_ID=local-team

THERMOX_WORKER_ID=local-worker-1
THERMOX_LIBRARY_THREADS=1
THERMOX_WORKER_POLL_MS=250

THERMOX_ENABLE_CANTERA=ON
THERMOX_IMAGE_TAG=local
